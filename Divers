

Vérifier les connexions actives :
SELECT pid, usename, application_name, state, query
FROM pg_stat_activity;

SELECT pid, usename, application_name, client_addr, backend_type, state
FROM pg_stat_activity
ORDER BY backend_type, pid;

Augmenter max_connections (si le serveur a assez de RAM) :
SHOW max_connections;
-- Modifier dans postgresql.conf
max_connections = 300

Tuer les connexions inutiles (temporaire) :

SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE state = 'idle';



SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE usename = 'monuser'
  AND pid <> pg_backend_pid();  -- exclut ta propre session


SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE usename = 'monuser'
  AND state = 'idle'
  AND pid <> pg_backend_pid();




